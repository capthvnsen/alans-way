# Example only. Configure DNS/TLS and the real host/path on your gateway.
# The Hermes dashboard and voice broker remain bound to loopback.
voice.example.net {
    header {
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
    }

    handle /v1/* {
        reverse_proxy 127.0.0.1:8765
    }

    handle_path /call/* {
        root * /srv/alans-workspace/mobile/miniapp
        @runtime path / /index.html /call.js /call.css /voice-client.js /lifecycle.js /assets/*.png
        handle @runtime {
            file_server
        }
        handle {
            respond 404
        }
    }
}
